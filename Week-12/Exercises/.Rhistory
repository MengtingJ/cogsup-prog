nsec = dim_h[2]
nchan = dim_h[3]
###################################################################
permutation_pvalue_h = matrix(data=NA, nrow = nchan, ncol = nsec, byrow = FALSE, dimnames = NULL)
for (sec in 1:nsec){
for (chan in 1:nchan){
testingdata = hub_delta_cen_h_mean[,sec,chan]
#    testingdata = matrix(data=hub_delta_cen_h[,,sec,chan], nrow = nsub*ntrial, ncol = 1)
permu_model = oneSamplePermutationTest(testingdata,alternative = "greater", mu = 0, exact = FALSE,
n.permutations = 10000, seed =1)
permutation_pvalue_h[chan,sec] = permu_model$p.value
}
}
View(permutation_pvalue_h)
