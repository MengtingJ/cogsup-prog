path <- ('C:/My/CognitiveEngLab/Phase 2/3. Network Analysis')
filenam_h_mean <- file.path(path,'hub_delta_cen_h_mean.mat')
filenam_l_mean <- file.path(path,'hub_delta_cen_l_mean.mat')
hub_delta_cen_h_mean <- readMat(filenam_h_mean)
hub_delta_cen_h_mean <- hub_delta_cen_h_mean[["hub.delta.cen.h.mean"]]
hub_delta_cen_l_mean <- readMat(filenam_l_mean)
hub_delta_cen_l_mean <- hub_delta_cen_l_mean[["hub.delta.cen.l.mean"]]
dim_h = dim(hub_delta_cen_h_mean)
nsub = dim_h[1]
nsec = dim_h[2]
nchan = dim_h[3]
###################################################################
permutation_pvalue_h = matrix(data=NA, nrow = nchan, ncol = nsec, byrow = FALSE, dimnames = NULL)
for (sec in 1:nsec){
for (chan in 1:nchan){
testingdata = hub_delta_cen_h_mean[,sec,chan]
#    testingdata = matrix(data=hub_delta_cen_h[,,sec,chan], nrow = nsub*ntrial, ncol = 1)
permu_model = oneSamplePermutationTest(testingdata,alternative = "greater", mu = 0, exact = FALSE,
n.permutations = 10000, seed =1)
permutation_pvalue_h[chan,sec] = permu_model$p.value
}
}
View(permutation_pvalue_h)
